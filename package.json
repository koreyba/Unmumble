{
  "name": "unmumble",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "deploy:branch-preview": "node scripts/deploy-worker.mjs branch-preview",
    "deploy:preview": "node scripts/deploy-worker.mjs preview",
    "deploy:production": "node scripts/deploy-worker.mjs production",
    "demo:seed-practice": "node scripts/practice-demo-data.mjs seed",
    "demo:reset-practice": "node scripts/practice-demo-data.mjs reset",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs && npm run test:worker",
    "test:ci": "node --test --test-reporter=spec --test-reporter=./scripts/github-actions-test-reporter.mjs --test-reporter-destination=stdout --test-reporter-destination=stdout tests/*.test.mjs",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "preview:chat": "node scripts/preview-chat.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern playwright-report --ignore-pattern test-results",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.87",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tanstack/react-virtual": "3.14.10",
    "ai": "^7.0.84",
    "drizzle-orm": "0.45.2",
    "jose": "^6.1.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  },
  "type": "module",
  "displayName": "Unmumble"
}
